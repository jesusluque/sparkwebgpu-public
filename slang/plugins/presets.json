{
  "//": "Plugin Slang and the presets tools/slang-build compiles. Each plugin names its module and the ISplatColour and/or IBlendTerm struct it adds; each preset is an ordered plugin set. The default preset (no plugins) is the kernels under kernels/, draw/ and tiles/ themselves. src/webgpu/plugins/PluginHost.ts picks a variant per active plugin set.",
  "plugins": {
    "example.tint": {
      "module": "plugins.examples.tint",
      "colour": "TintColour"
    },
    "example.fade": { "module": "plugins.examples.fade", "blend": "FadeBlend" },
    "athenea.raster": {
      "module": "athenea_adapter.raster",
      "colour": "AtheneaRasterColour"
    },
    "athenea.relight": {
      "module": "athenea_adapter.relight_colour",
      "colour": "AtheneaRelightColour"
    },
    "athenea.lights": {
      "module": "athenea_adapter.lights",
      "colour": "AtheneaLightsColour"
    }
  },
  "presets": [
    { "name": "tint", "plugins": ["example.tint"] },
    { "name": "fade", "plugins": ["example.fade"] },
    { "name": "tint-fade", "plugins": ["example.tint", "example.fade"] },
    { "name": "athenea-raster", "plugins": ["athenea.raster"] },
    { "name": "athenea-relight", "plugins": ["athenea.relight"] },
    { "name": "athenea-lights", "plugins": ["athenea.lights"] },
    {
      "name": "athenea-raster-lights",
      "plugins": ["athenea.raster", "athenea.lights"]
    },
    {
      "name": "athenea-relight-lights",
      "plugins": ["athenea.relight", "athenea.lights"]
    }
  ]
}
